[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Agent Framework — unpinned, let resolver find compatible set
autogen-agentchat = "==0.7.5"
autogen-ext = {version = "==0.7.5", extras = ["openai"]}

# Vector DB & RAG — these are stable, keep pinned
chromadb = "==0.5.3"
langchain = "==0.2.12"
langchain-openai = "==0.1.20"
langchain-community = "==0.2.10"
tiktoken = "==0.12.0"

# Data & Config — stable, keep pinned
python-dotenv = "==1.0.1"
pandas = "==2.2.2"

# Let these resolve freely alongside autogen
openai = "==1.109.1"
pydantic = "==2.12.5"

# API Server
fastapi = "==0.129.0"
uvicorn = "==0.40.0"

[dev-packages]
pytest = "==8.3.2"
black = "==24.8.0"
ipykernel = "==6.29.5"

[requires]
python_version = "3.11"
python_full_version = "3.11.14"